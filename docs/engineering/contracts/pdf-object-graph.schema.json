{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.paperbridge.dev/pdf-object-graph.schema.json",
  "title": "PaperBridge PDF Object Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "documentVersionId",
    "parser",
    "coordinateSystem",
    "pages",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "documentVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "objectGraphVersion"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "objectGraphVersion": {
          "const": "1"
        },
        "pdfjsVersion": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "coordinateSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "unit",
        "xDirection",
        "yDirection"
      ],
      "properties": {
        "origin": {
          "const": "top-left"
        },
        "unit": {
          "const": "normalized-0-1"
        },
        "xDirection": {
          "const": "right"
        },
        "yDirection": {
          "const": "down"
        }
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "normRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "textItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "bounds",
        "direction",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "text": {
          "type": "string"
        },
        "bounds": {
          "$ref": "#/$defs/normRect"
        },
        "fontName": {
          "type": "string",
          "maxLength": 200
        },
        "fontSize": {
          "type": "number",
          "minimum": 0
        },
        "direction": {
          "enum": [
            "ltr",
            "rtl",
            "ttb"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "transform": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "itemIds",
        "bounds",
        "text",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "bounds": {
          "$ref": "#/$defs/normRect"
        },
        "text": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "lineIds",
        "bounds",
        "quads",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "enum": [
            "heading",
            "paragraph",
            "caption",
            "list",
            "table",
            "figure",
            "equation",
            "reference",
            "header",
            "footer",
            "other"
          ]
        },
        "lineIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "bounds": {
          "$ref": "#/$defs/normRect"
        },
        "quads": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/normRect"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "sectionPath": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 500
          }
        },
        "captionBlockId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "pageNumber",
        "width",
        "height",
        "rotation",
        "textItems",
        "lines",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "pageNumber": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "textItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textItem"
          }
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "textless": {
          "type": "boolean",
          "default": false
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
