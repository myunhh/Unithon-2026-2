{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.paperbridge.dev/selection-anchor.schema.json",
  "title": "PaperBridge SelectionAnchor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentId",
    "documentVersionId",
    "pageNumber",
    "rects"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "documentVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "pageNumber": {
      "type": "integer",
      "minimum": 1
    },
    "rects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/normRect"
      }
    },
    "textRange": {
      "$ref": "#/$defs/textRange"
    },
    "selectedText": {
      "type": "string",
      "maxLength": 12000
    },
    "blockIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    }
  },
  "$defs": {
    "normRect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startItemId",
        "startOffset",
        "endItemId",
        "endOffset"
      ],
      "properties": {
        "startItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "startOffset": {
          "type": "integer",
          "minimum": 0
        },
        "endItemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "endOffset": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
