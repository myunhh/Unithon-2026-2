{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.paperbridge.dev/agent-runtime-event.schema.json",
  "title": "PaperBridge Agent Runtime Event",
  "oneOf": [
    {
      "$ref": "#/$defs/accepted"
    },
    {
      "$ref": "#/$defs/started"
    },
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/citation"
    },
    {
      "$ref": "#/$defs/warning"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/failed"
    },
    {
      "$ref": "#/$defs/cancelled"
    },
    {
      "$ref": "#/$defs/completed"
    }
  ],
  "$defs": {
    "baseEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "eventId",
        "runId",
        "sequence",
        "type",
        "occurredAt",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "runId": {
          "type": "string",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "providerCode": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "modelId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTokens",
        "outputTokens",
        "costMicrousd",
        "currency",
        "estimated"
      ],
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "costMicrousd": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "const": "USD"
        },
        "estimated": {
          "type": "boolean"
        }
      }
    },
    "citation": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.citation"
            },
            "payload": {
              "$ref": "#/$defs/citation"
            }
          }
        }
      ]
    },
    "resultPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidenceStatus",
        "citations"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "evidenceStatus": {
          "enum": [
            "supported",
            "partially_supported",
            "unsupported_by_document",
            "not_required"
          ]
        },
        "citations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "structured": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      }
    },
    "errorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,99}$"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "accepted": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.accepted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reservedCostMicrousd"
              ],
              "properties": {
                "reservedCostMicrousd": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    },
    "started": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          }
        }
      ]
    },
    "delta": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.delta"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "maxLength": 32000
                }
              }
            }
          }
        }
      ]
    },
    "warning": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.warning"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      ]
    },
    "result": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.result"
            },
            "payload": {
              "$ref": "#/$defs/resultPayload"
            }
          }
        }
      ]
    },
    "failed": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.failed"
            },
            "payload": {
              "$ref": "#/$defs/errorPayload"
            }
          }
        }
      ]
    },
    "cancelled": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.cancelled"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          }
        }
      ]
    },
    "completed": {
      "allOf": [
        {
          "$ref": "#/$defs/baseEvent"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "run.completed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "succeeded",
                    "failed",
                    "cancelled"
                  ]
                },
                "usage": {
                  "$ref": "#/$defs/usage"
                }
              }
            }
          }
        }
      ]
    }
  }
}
