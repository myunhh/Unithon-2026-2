# Public frontend configuration. Use /api for the existing same-origin compatibility proxy.
VITE_PUBLIC_API_URL=/api

# Server-only configuration. Never rename SUPABASE_SECRET_KEY with a VITE_ prefix.
NODE_ENV=development
PORT=8787
APP_ORIGINS=http://127.0.0.1:5173
# Keep this server-only value stable in every deployed environment. Electron
# supplies an installation-scoped value before starting its local server.
# Production requires 32-128 unpadded base64url characters.
PAPERBRIDGE_SESSION_SECRET=
# 32 random bytes encoded as unpadded base64url: base64url:<43 characters>.
PAPERBRIDGE_ENCRYPTION_KEY_V1=
PAPERBRIDGE_ACTIVE_KEY_VERSION=1
PAPERBRIDGE_MAX_PDF_BYTES=52428800
PAPERBRIDGE_MAX_ACTIVE_RUNS_PER_USER=4
SUPABASE_URL=
SUPABASE_SECRET_KEY=
