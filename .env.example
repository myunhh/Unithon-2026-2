# Server-only configuration. Never rename SUPABASE_SECRET_KEY with a VITE_ prefix.
PORT=8787
APP_ORIGIN=http://127.0.0.1:5173
# Keep this server-only value stable in deployed web environments. Electron
# creates and persists an installation-scoped value when this is not supplied.
PAPERBRIDGE_SESSION_SECRET=
# 32 random bytes encoded as unpadded base64url: base64url:<43 characters>.
PAPERBRIDGE_ENCRYPTION_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
