{
  "name": "paperbridge",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --names web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:desktop": "concurrently -k --names services,desktop \"npm:dev\" \"npm:desktop\"",
    "desktop": "npm run build:electron && wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist-electron/electron/main.js",
    "build:electron": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist-electron', { recursive: true, force: true });\" && tsc -p tsconfig.electron.build.json",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint src server electron",
    "preview": "vite preview",
    "start:api": "tsx server/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "oxlint": "^1.79.0",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  }
}
